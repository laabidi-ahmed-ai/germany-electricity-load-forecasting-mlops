# ---------------------------------------------------------------------------
# Copy to .env for local use (never commit .env). Add the same keys as
# GitHub Secrets for the cloud jobs. See README §12.
# ---------------------------------------------------------------------------

# ENTSO-E Transparency Platform security token. Optional: the system runs on
# SMARD / historical data without it; live ENTSO-E ingestion switches on once set.
ENTSOE_API_TOKEN=your_entsoe_security_token_here

# Postgres / TimescaleDB connection string (Neon or Supabase free tier).
# Leave unset to fall back to a local SQLite file under data/ for development.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Open-Meteo (no key required).
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# MLflow tracking store. Default: local SQLite DB under mlruns/ (free, no server).
# In the cloud (GitHub Actions) this is the Postgres DATABASE_URL: MLflow keeps its
# lineage tables there and the champion model is exported to the model_artifacts
# table, so nothing depends on a runner's disk. A plain directory (./mlruns) still
# works but uses MLflow's legacy file store.
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# Target geography: ENTSO-E bidding zone / SMARD region for Germany.
BIDDING_ZONE=DE_LU
SMARD_REGION=DE

# First day of training data (post-COVID cutoff: pandemic demand patterns are unrepresentative).
DATA_START_DATE=2021-03-01

# Logging
LOG_LEVEL=INFO
